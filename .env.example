# ==============================================================================
# AgriFact-Checker Environment Configuration
# ==============================================================================
# Copy this file to `.env` and adjust the values as needed for your environment.

# Flask Application Settings
FLASK_APP=app.py
FLASK_ENV=development
FLASK_DEBUG=1
FLASK_SECRET_KEY=replace-with-a-secure-random-secret-key-in-production

# Server Settings
HOST=127.0.0.1
PORT=5000

# SQLite Database Storage Location
# Defaults to instance/checker.db relative to project root
DATABASE_PATH=instance/checker.db

# Machine Learning Artifacts
# Trained classifier model binary (CalibratedClassifierCV + LogisticRegression)
MODEL_PATH=model/classifier.joblib

# Trained feature union TF-IDF vectorizer binary
VECTORIZER_PATH=model/vectorizer.joblib

# Model metrics export JSON file
METRICS_PATH=model/metrics.json

# Domain Whitelist Path
VERIFIED_DOMAINS_PATH=config/verified_domains.json

# Input Validation Limits
# Maximum allowed characters for submitted claim texts
MAX_INPUT_LENGTH=5000
